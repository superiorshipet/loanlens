@Host = http://localhost:5257

### 1. Health Checks
GET {{Host}}/healthz
Accept: application/json

### 2. Readiness Check
GET {{Host}}/ready
Accept: application/json

### 3. Calculate Amortization Schedule
POST {{Host}}/api/v1/loans/calculate
Content-Type: application/json

{
  "principal": 100000,
  "tenorMonths": 24,
  "annualInterestRatePercentage": 22.0,
  "calculationMethod": 1,
  "rateType": 1,
  "adminFeePercentage": 1.5
}

### 4. Analyze Affordability (DTI & Emergency Runway)
POST {{Host}}/api/v1/loans/affordability
Content-Type: application/json

{
  "profile": {
    "monthlyIncome": 25000,
    "age": 32,
    "stability": 1,
    "fixedMonthlyExpenses": 9000,
    "currentMonthlyInstallments": 1500,
    "savings": 40000,
    "dependentsCount": 1,
    "hasHealthInsurance": true
  },
  "loan": {
    "principal": 100000,
    "tenorMonths": 36,
    "annualInterestRatePercentage": 22.0,
    "calculationMethod": 1,
    "rateType": 1,
    "adminFeePercentage": 1.5
  }
}

### 5. Stress Testing Shocks
POST {{Host}}/api/v1/loans/stress-test
Content-Type: application/json

{
  "profile": {
    "monthlyIncome": 25000,
    "age": 32,
    "stability": 1,
    "fixedMonthlyExpenses": 9000,
    "currentMonthlyInstallments": 1500,
    "savings": 40000,
    "dependentsCount": 1,
    "hasHealthInsurance": true
  },
  "loan": {
    "principal": 100000,
    "tenorMonths": 36,
    "annualInterestRatePercentage": 22.0,
    "calculationMethod": 1,
    "rateType": 1,
    "adminFeePercentage": 1.5
  }
}

### 6. Monte Carlo Default Probability Simulation
POST {{Host}}/api/v1/loans/monte-carlo
Content-Type: application/json

{
  "profile": {
    "monthlyIncome": 25000,
    "age": 32,
    "stability": 1,
    "fixedMonthlyExpenses": 9000,
    "currentMonthlyInstallments": 1500,
    "savings": 40000,
    "dependentsCount": 1,
    "hasHealthInsurance": true
  },
  "loan": {
    "principal": 100000,
    "tenorMonths": 36,
    "annualInterestRatePercentage": 22.0,
    "calculationMethod": 1,
    "rateType": 1,
    "adminFeePercentage": 1.5
  },
  "iterations": 5000
}

### 7. Get Egyptian Market Loan Catalog
GET {{Host}}/api/v1/loans/catalog
Accept: application/json

### 8. List Recent Saved Scenarios
GET {{Host}}/api/v1/loans/scenarios?count=10
Accept: application/json

### 9. Calculate Maximum Borrowing Capacity
POST {{Host}}/api/v1/loans/borrowing-capacity
Content-Type: application/json

{
  "monthlyIncome": 25000,
  "existingMonthlyObligations": 2000,
  "tenorMonths": 36,
  "expectedAnnualInterestRatePercentage": 22.0
}

### 10. User Registration
POST {{Host}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "Password@123",
  "fullName": "Ahmed Hassan"
}

### 11. User / Admin Login
# @name login
POST {{Host}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@loanlens.com",
  "password": "Admin@123456"
}

### 12. Get Current Authenticated User Profile
@authToken = {{login.response.body.token}}
GET {{Host}}/api/v1/auth/me
Authorization: Bearer {{authToken}}
Accept: application/json

### 13. Admin: List All Registered Users
GET {{Host}}/api/v1/admin/users
Authorization: Bearer {{authToken}}
Accept: application/json

### 14. Admin: List All Scenarios Across All Users
GET {{Host}}/api/v1/admin/scenarios?count=50
Authorization: Bearer {{authToken}}
Accept: application/json

### 15. Get Egyptian Banking Market Rates (CBE Corridor & Commercial Banks)
GET {{Host}}/api/v1/market-rates
Accept: application/json

### 16. Admin: Force Refresh Market Rates Cache
POST {{Host}}/api/v1/market-rates/refresh
Authorization: Bearer {{authToken}}
Accept: application/json

