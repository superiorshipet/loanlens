  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5257",
      "type": "string"
    },
    {
      "key": "scenarioId",
      "value": "",
      "type": "string"
    },
    {
      "key": "lang",
      "value": "en",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Full 360 Advisor Analysis (All Engines)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept-Language",
            "value": "{{lang}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"Ahmed Mahmoud\",\n  \"profile\": {\n    \"monthlyIncome\": 25000,\n    \"stability\": 1,\n    \"fixedMonthlyExpenses\": 9000,\n    \"currentMonthlyInstallments\": 1500,\n    \"savings\": 50000,\n    \"dependentsCount\": 1,\n    \"age\": 32,\n    \"hasHealthInsurance\": true,\n    \"secondaryIncome\": 2000\n  },\n  \"loan\": {\n    \"principal\": 100000,\n    \"tenorMonths\": 36,\n    \"annualInterestRatePercentage\": 22.0,\n    \"calculationMethod\": 1,\n    \"rateType\": 1,\n    \"adminFeePercentage\": 1.5,\n    \"earlyRepaymentFeePercentage\": 3.0,\n    \"latePaymentPenaltyPercentage\": 2.0\n  },\n  \"monteCarloIterations\": 5000,\n  \"monteCarloOptions\": {\n    \"iterations\": 5000,\n    \"customIncomeVolatilityPercentage\": 15.0,\n    \"customEmergencyAnnualProbability\": 10.0,\n    \"customEmergencyCost\": 25000\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/loans/full-analysis?lang={{lang}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "loans", "full-analysis"],
          "query": [
            {
              "key": "lang",
              "value": "{{lang}}"
            }
          ]
        },
        "description": "Executes full pipeline: Amortization Schedule, Affordability (DTI), 7 Stress Shocks, 5000-path Monte Carlo, 0-100 Risk Score, Strategy Options, and Market Catalog Comparison. Returns English by default or Arabic when lang=ar."
      }
    },
