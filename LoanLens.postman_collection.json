          "raw": "{\n  \"profile\": {\n    \"monthlyIncome\": 22000,\n    \"stability\": 2,\n    \"fixedMonthlyExpenses\": 9000,\n    \"currentMonthlyInstallments\": 1500,\n    \"savings\": 40000,\n    \"dependentsCount\": 1,\n    \"age\": 31,\n    \"hasHealthInsurance\": false,\n    \"secondaryIncome\": 1000\n  },\n  \"loan\": {\n    \"principal\": 90000,\n    \"tenorMonths\": 36,\n    \"annualInterestRatePercentage\": 20.0,\n    \"calculationMethod\": 1,\n    \"rateType\": 1,\n    \"adminFeePercentage\": 1.5,\n    \"earlyRepaymentFeePercentage\": 3.0,\n    \"latePaymentPenaltyPercentage\": 2.0\n  },\n  \"iterations\": 5000,\n  \"options\": {\n    \"iterations\": 5000,\n    \"customIncomeVolatilityPercentage\": 18.0,\n    \"customEmergencyAnnualProbability\": 12.0,\n    \"customEmergencyCost\": 20000\n  }\n}"
